# Receipt parser worker (SQS consumer, ADR-010). Build context: receipt_parser/
#   docker build --platform linux/arm64 -f Dockerfile.worker -t <repo>:latest .
# Separate from the legacy HTTP service image (Dockerfile): the dummy worker needs only boto3.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY worker/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY worker/ ./worker/

RUN useradd --system --no-create-home worker
USER worker

CMD ["python", "-m", "worker.main"]
